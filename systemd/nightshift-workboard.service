[Unit]
Description=Night Shift Workboard Production
After=network-online.target openclaw-gateway.service
Wants=network-online.target openclaw-gateway.service

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/releases/nightshift-workboard/current
Environment=HOME=/home/openclaw
Environment=OPENCLAW_HOME=/home/openclaw
Environment=OPENCLAW_STATE_DIR=/home/openclaw/.openclaw
Environment=OPENCLAW_CONFIG_PATH=/home/openclaw/.openclaw/openclaw.json
Environment=PATH=/opt/node-v22.23.1/bin:/home/openclaw/.local/bin:/home/openclaw/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=NIGHTSHIFT_OPENCLAW_COMMAND=/opt/node-v22.23.1/bin/node
Environment=NIGHTSHIFT_OPENCLAW_ENTRY=/opt/openclaw-2026.7.1/node_modules/openclaw/dist/index.js
Environment=NIGHTSHIFT_GATEWAY_URL=ws://127.0.0.1:22793
Environment=NIGHTSHIFT_HOST=127.0.0.1
Environment=NIGHTSHIFT_PORT=24879
Environment=NIGHTSHIFT_DATA_DIR=/home/openclaw/.openclaw/nightshift
Environment=NIGHTSHIFT_BOARD=nightshift
Environment=NIGHTSHIFT_PUBLIC_HOST=nightshift.tianyi.live
Environment=NIGHTSHIFT_PUBLIC_BASE_URL=https://nightshift.tianyi.live
Environment=NIGHTSHIFT_BASIC_AUTH_FILE=/home/openclaw/.config/nightshift/public-auth.json
Environment=NIGHTSHIFT_WORKFLOW_PATH=/home/openclaw/releases/nightshift-workboard/current/examples/workflows/xingqing-content-delivery.workflow.md
ExecStart=/opt/node-v22.23.1/bin/node --no-warnings apps/nightshift-dashboard/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/openclaw/.openclaw/nightshift /home/openclaw/.openclaw/state

[Install]
WantedBy=multi-user.target
